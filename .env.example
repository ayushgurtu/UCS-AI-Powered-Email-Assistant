# UCS AI-Powered Email Assistant - environment for docker-compose.yaml
# Template: copy to .env and fill in N8N_ENCRYPTION_KEY. Never commit .env.

# Encrypts all stored n8n credentials. Set once, never change it.
# Losing or changing it makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=<generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# n8n image tag; pin a specific version for stable deployments, e.g. 2.1.0
N8N_VERSION=latest

# Public URL of this n8n instance. Must match the OAuth redirect URI
# registered for Outlook / OneDrive / Dropbox: <WEBHOOK_URL>rest/oauth2-credential/callback
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http

# Timezone for the scheduled indexer and retention purge
TIMEZONE=Asia/Singapore
