    {
      "parameters": {
        "jsCode": "// Seed start from persisted LastRunTimestamp (fallback to a floor), end = now.\nconst rows = $items('Get Last Run').map(i => i.json);\nlet seed = null;\nfor (const r of rows) {\n  if (r && r.LastRunTimestamp) { seed = r.LastRunTimestamp; break; }\n}\nconst startDate = seed ? new Date(seed) : new Date('1900-01-01T00:00:00Z');\nconst now = new Date($('Schedule Trigger').first().json.timestamp);\n\nconst windows = [];\nlet s = new Date(startDate);\nwhile (s < now) {\n  // END = START + 1 year (rule 1); clamp last window to 'now'\n  let e = new Date(s);\n  e.setUTCDate(e.getUTCDate() + 15);\n  // e.setUTCMonth(e.getUTCMonth() + 1);\n  if (e > now) e = new Date(now);\n  windows.push({\n    BACKFILL_START: s.toISOString(),\n    BACKFILL_END: e.toISOString()\n  });\n  // next START = this END (rule 3)\n  s = new Date(e);\n}\n\n// If already up to date, emit nothing so the loop's done-branch runs the tail once.\nreturn windows.map(w => ({ json: w }));"
      },
      "id": "3172077d-c2a5-4a85-a3b7-453d4b7d12ee",
      "name": "Build Year Windows",
